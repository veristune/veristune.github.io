<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>ArchivalTube</title>
<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        background-color: #f5f5f5;
    }

    .topbar {
        background-color: #e6bcbc;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 18px;
    }

    .logo {
        font-weight: bold;
    }

    .logo span {
        color: red;
    }

    .topbar a {
        margin-left: 20px;
        text-decoration: none;
        color: black;
    }

    .container {
        display: flex;
        padding: 20px;
    }

    .video-box {
        width: 360px;
    }

    .video-box img {
        width: 100%;
        border: 1px solid #ccc;
        margin-bottom: 10px;
    }

    video {
        width: 100%;
        border: 1px solid #ccc;
        margin-bottom: 10px;
        background: black;
    }

    .note {
        background: #eee;
        padding: 10px;
        font-size: 14px;
        color: #a33;
    }

    .info {
        margin-left: 20px;
        max-width: 600px;
    }

    .info p {
        margin: 5px 0;
    }

    .green {
        color: green;
    }

    .small {
        font-size: 13px;
        color: gray;
    }

    .history {
        padding: 20px;
    }

    .history h1 {
        font-size: 48px;
        margin-bottom: 10px;
    }

    .history a {
        font-size: 20px;
        text-decoration: none;
        margin-right: 10px;
    }

    .csv {
        color: blue;
    }

    .contribute {
        color: green;
    }
</style>
</head>
